library(writexl)
library(ggplot2)
library(patchwork)
# import B_gal activity
df_activity <- read_xlsx("~/Library/CloudStorage/Box-Box/Feaga Lab/Cassidy Prince/Bella/BACTH/B-gal/all_bs_bgal.xlsx")
# import B_gal activity
df_activity <- read_xlsx("C:/Users/cassp/Box Sync/Feaga Lab/Cassidy Prince/Bella/BACTH/B-gal/all_bs_bgal.xlsx")
# calculate mean and standard error of b-gal assay for each transformation
activity <- df_activity %>%
group_by(transformation) %>%
summarize(mean_B_gal_activity = mean(B_gal_activity), sem_B_gal_activity = sd(B_gal_activity)/sqrt(n()))
activity$species <- ifelse(activity$transformation %in% c(1,2,3,9,10,11), "B. subtilis", "P. polymyxa")
activity$protein <- ifelse(activity$transformation %in% c(1,2,3,4,5,6,7,8), "Spo0A", "Spo0F")
# make sure transformations are plotted in the right order; plot subtilis first
activity$transformation <- factor(activity$transformation, levels = sort(as.numeric(activity$transformation)))
#activity$species <- factor(activity$species, levels = c("B. subtilis", "P. polymyxa"))
activity$protein <- factor(activity$protein, levels = c("Spo0F", "Spo0A"))
# Plot Spo0F
activity_spo0F <- activity %>% filter(protein == "Spo0F")
colors <- c("#006400", "gray", "gray")
p_spo0F <- ggplot(activity_spo0F, aes(x = transformation, y = mean_B_gal_activity, fill = transformation)) +
geom_col() +
ylab("Miller units") +
scale_y_continuous(expand = expansion(mult = 0)) +
scale_fill_manual(values = colors) +
geom_errorbar(aes(ymin = mean_B_gal_activity - sem_B_gal_activity,
ymax = mean_B_gal_activity + sem_B_gal_activity),
width = 0.2) +
theme_classic() +
scale_x_discrete(labels = c("T18-Spo0B", "T18", "T18-Spo0B")) +
theme(text = element_text(size = 12),
legend.position = "none",
axis.text = element_text(color = "black"),
axis.ticks = element_line(color = "black")) +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1),
axis.title.x = element_blank())
p_spo0F
max_y_spo0F <- max(activity_spo0F$mean_B_gal_activity + activity_spo0F$sem_B_gal_activity)
p1_spo0F <- p_spo0F +
coord_cartesian(ylim = c(0, max_y_spo0F * 1.1)) +
# --- First two bars grouped (bars 1 and 2) ---
geom_segment(aes(x = 0.6, xend = 2.4,
y = max_y_spo0F * 1.03, yend = max_y_spo0F * 1.03),
inherit.aes = FALSE, size = 1) +
annotate("text", x = 1.5, y = max_y_spo0F * 1.06,
label = "Spo0F-T25", size = 3.5) +
# --- Last bar (bar 3) ---
geom_segment(aes(x = 2.6, xend = 3.4,
y = max_y_spo0F * 1.03, yend = max_y_spo0F * 1.03),
inherit.aes = FALSE, size = 1) +
annotate("text", x = 3, y = max_y_spo0F * 1.06,
label = "T25", size = 3.5)
p1_spo0F
# Plot SpoA
activity_spo0A <- activity %>% filter(protein == "Spo0A")
colors <- c("#542788", "gray", "gray")
p_spo0A <- ggplot(activity_spo0A, aes(x = transformation, y = mean_B_gal_activity, fill = transformation)) +
geom_col() +
ylab("Miller units") +
scale_y_continuous(expand = expansion(mult = 0)) +
scale_fill_manual(values = colors) +
geom_errorbar(aes(ymin = mean_B_gal_activity - sem_B_gal_activity,
ymax = mean_B_gal_activity + sem_B_gal_activity),
width = 0.2,
position = position_dodge(0.9)) +
theme_classic() +
theme(text = element_text(size = 12)) +
theme(legend.position = "none",
axis.text = element_text(color = "black"),
axis.ticks = element_line(color = "black")) +
scale_x_discrete(labels = c("Spo0B-T18", "T18", "Spo0B-T18")) +
theme(axis.text.x = element_text(angle = 45, vjust = 1, hjust = 1),
axis.title.x = element_blank())
p_spo0A
max_y_spo0A <- max(activity_spo0A$mean_B_gal_activity + activity_spo0A$sem_B_gal_activity)
p1_spo0A <- p_spo0A +
coord_cartesian(ylim = c(0, max_y_spo0A * 1.1)) +
geom_segment(aes(x = 0.6, xend = 2.4, y = max_y_spo0A * 1.05, yend = max_y_spo0A * 1.05),
inherit.aes = FALSE, size = 1) +
annotate("text", x = 1.5, y = max_y_spo0A * 1.08, label = "Spo0A-T25", size = 3.5) +
geom_segment(aes(x = 2.6, xend = 3.4, y = max_y_spo0A * 1.05, yend = max_y_spo0A * 1.05),
inherit.aes = FALSE, size = 1) +
annotate("text", x = 3, y = max_y_spo0A * 1.08, label = "T25", size = 3.5) +
theme(axis.title.y = element_blank())
p1_spo0A
# Combine plots side by side
combined_plot <- (p1_spo0F + coord_cartesian(ylim = c(0, max(activity_spo0F$mean_B_gal_activity + activity_spo0F$sem_B_gal_activity) * 1.11))) +
(p1_spo0A + coord_cartesian(ylim = c(0, max(activity_spo0A$mean_B_gal_activity + activity_spo0A$sem_B_gal_activity) * 1.11)))
combined_plot
# Spo0F (use its own max)
max_y_spo0F <- max(activity_spo0F$mean_B_gal_activity + activity_spo0F$sem_B_gal_activity)
p1_spo0F <- p_spo0F +
coord_cartesian(ylim = c(0, max_y_spo0F * 1.1)) +
geom_segment(aes(x = 0.6, xend = 2.4,
y = max_y_spo0F * 1.03, yend = max_y_spo0F * 1.03),
inherit.aes = FALSE, size = 1) +
annotate("text", x = 1.5, y = max_y_spo0F * 1.06,
label = "Spo0F-T25", size = 3.5) +
geom_segment(aes(x = 2.6, xend = 3.4,
y = max_y_spo0F * 1.03, yend = max_y_spo0F * 1.03),
inherit.aes = FALSE, size = 1) +
annotate("text", x = 3, y = max_y_spo0F * 1.06,
label = "T25", size = 3.5)
# Spo0A (use its own max)
max_y_spo0A <- max(activity_spo0A$mean_B_gal_activity + activity_spo0A$sem_B_gal_activity)
p1_spo0A <- p_spo0A +
coord_cartesian(ylim = c(0, max_y_spo0A * 1.1)) +
geom_segment(aes(x = 0.6, xend = 2.4,
y = max_y_spo0A * 1.03, yend = max_y_spo0A * 1.03),
inherit.aes = FALSE, size = 1) +
annotate("text", x = 1.5, y = max_y_spo0A * 1.06,
label = "Spo0A-T25", size = 3.5) +
geom_segment(aes(x = 2.6, xend = 3.4,
y = max_y_spo0A * 1.03, yend = max_y_spo0A * 1.03),
inherit.aes = FALSE, size = 1) +
annotate("text", x = 3, y = max_y_spo0A * 1.06,
label = "T25", size = 3.5) +
theme(axis.title.y = element_blank())
# Combine plots side by side (different axes)
combined_plot <- p1_spo0F + p1_spo0A
combined_plot
