theme_classic() +
labs(x = "Position", y = "-log10(p-value)") +
theme(
axis.text.x = element_blank()
) +
scale_y_continuous(expand = c(0,0), n.breaks = 7, limits = c(0,10)) +
scale_color_gradient(name = "difference in \nmean cytotoxicity", low = "gray90", high = "darkblue") +
